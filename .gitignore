# ==============================================================================
# AI Agriculture Project — .gitignore
# ==============================================================================

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# ── Virtual Environment ──
venv/
.venv/
env/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db
desktop.ini

# ── Environment Variables ──
.env

# ── Trained Models ──
!saved_models/
!saved_models/*.keras
!saved_models/*.h5

# Ignore models >100MB to avoid GitHub file size limits (unless Git LFS is enabled)
saved_models/ResNet50_*.keras
saved_models/ResNet50_*.h5

# ── Reports & Research Data (tracked for reproducible dashboard & metrics) ──
!reports/
!reports/**

# ── Dataset (too large for git) ──
PlantVillage/
data/raw/
data/processed/
data/external/

# ── Logs ──
logs/
*.log

# ── Temporary ──
*.tmp
*.bak
train_remaining.py

# ── Jupyter ──
.ipynb_checkpoints/
notebooks/*.ipynb

# ── Keras Tuner ──
hp_tuning/

# ── Raw Dataset Images ──
Pepper__bell___Bacterial_spot/
Pepper__bell___healthy/
Potato___Early_blight/
Potato___healthy/
Potato___Late_blight/
Tomato_Bacterial_spot/
Tomato_Early_blight/
Tomato_healthy/
Tomato_Late_blight/
Tomato_Leaf_Mold/
Tomato_Septoria_leaf_spot/
Tomato_Spider_mites_Two_spotted_spider_mite/
Tomato__Target_Spot/
Tomato__Tomato_mosaic_virus/
Tomato__Tomato_YellowLeaf__Curl_Virus/
